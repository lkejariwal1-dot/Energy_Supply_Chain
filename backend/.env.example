# Copy this file to .env and adjust as needed.

# Port the Express server listens on. The frontend's vite.config.js proxies
# /api to http://localhost:5000 by default, so keep this at 5000 unless you
# also update the frontend proxy / VITE_API_URL.
PORT=5000

# Path to the local SQLite database file (relative to the backend/ folder,
# or an absolute path). Created automatically on first run if it doesn't
# exist. If the file can't be opened for some reason, the server
# automatically falls back to an in-memory data store seeded with the same
# demo data - so `npm run dev` always works. Run `npm run seed` once to
# populate it with demo data + computed corridor/route risk scores.
SQLITE_PATH=./data/energy.db

# Comma-separated list of origins allowed to call this API. The Vite dev
# server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# NewsData.io API key — powers live geopolitical/oil-market news on
# GET /api/risk/events. Get one free at https://newsdata.io.
# If unset (or the request fails/rate-limits/times out), the endpoint
# automatically falls back to the seed event timeline instead of erroring.
NEWS_API_KEY=

# How long (ms) a successful news response is cached before re-fetching.
# Keeps repeated dashboard polling from burning through the free-tier rate
# limit. Default: 10 minutes.
NEWS_CACHE_TTL_MS=600000
